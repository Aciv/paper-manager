# Copy this file to .env for local development. Values exported by the shell,
# Docker, or the deployment platform take precedence over this file.

# HTTP API and PostgreSQL
HTTP_ADDR=127.0.0.1:8080
# Slow-client bounds. Uploads use the read budget, content/reference downloads
# use the write budget; keep them generous for large PDFs.
HTTP_READ_TIMEOUT=5m
HTTP_WRITE_TIMEOUT=10m
HTTP_IDLE_TIMEOUT=2m
# Maximum time to let in-flight HTTP handlers finish on SIGTERM.
HTTP_SHUTDOWN_TIMEOUT=30s
# Non-multipart JSON bodies are buffered only up to this size (multipart
# uploads keep FILE_MAX_UPLOAD_SIZE / batch limits).
HTTP_MAX_JSON_BYTES=1048576
# Mutating requests are limited per client IP; uploads/batch imports also have
# their own in-flight concurrency caps and return 429 when saturated.
HTTP_WRITE_RATE_PER_MINUTE=300
HTTP_WRITE_RATE_BURST=60
HTTP_UPLOAD_CONCURRENCY=4
HTTP_BATCH_CONCURRENCY=2
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Empty trusts
# only the direct peer (recommended unless the API is behind a known proxy).
HTTP_TRUSTED_PROXIES=
# Optional loopback MCP adapter in the API process. When MCP_TOKEN is set,
# every request must send "Authorization: Bearer <token>". When it is empty,
# authentication is disabled (a warning is logged for non-loopback binds).
MCP_ENABLED=false
MCP_ADDR=127.0.0.1:8090
MCP_TOKEN=
MCP_MAX_REQUEST_BYTES=8388608
# Maximum bytes returned by document_read_block_image (default 12 MiB).
MCP_MAX_IMAGE_BYTES=12582912
# Concurrent MCP import calls (single and batch tools share this gate).
# Each batch call accepts 1-20 items and processes them sequentially while
# holding one slot, so this also bounds concurrent item imports.
MCP_IMPORT_CONCURRENCY=20
# Optional absolute directory that enables papers_manager_library_import_file.
# The adapter rejects paths outside this root, including symlink escapes.
# Leave empty to disable local-file import.
MCP_LOCAL_IMPORT_ROOT=
# Synchronous batch URL imports stop with partial results after this budget.
BATCH_IMPORT_TIMEOUT=2m
DB_DRIVER=postgres
DATABASE_URL=postgres://papers:papers@localhost:5432/papers?sslmode=disable
# Workers and HTTP share this pool. Keep max_open >= ASYNQ_CONCURRENCY + 8;
# startup logs a warning when it is smaller. statement_timeout caps one query.
DB_MAX_OPEN_CONNS=48
DB_MAX_IDLE_CONNS=24
DB_STATEMENT_TIMEOUT=30s
CORS_ORIGIN=http://localhost:5173
AUTO_MIGRATE=true

# Base -> .bib snapshot export. DOI requests use doi.org BibTeX content
# negotiation; failed or budget-exhausted requests fall back to paper_metadata.
BIBLIOGRAPHY_MAX_ENTRIES=200
BIBLIOGRAPHY_DOI_CONCURRENCY=4
BIBLIOGRAPHY_DOI_TIMEOUT=5s
BIBLIOGRAPHY_TOTAL_TIMEOUT=30s
BIBLIOGRAPHY_DOI_MAX_BODY_BYTES=262144
BIBLIOGRAPHY_MAX_OUTPUT_BYTES=8388608
BIBLIOGRAPHY_MAX_RESPONSE_BYTES=12582912
BIBLIOGRAPHY_DOI_CACHE_ENTRIES=100
BIBLIOGRAPHY_DOI_CACHE_TTL=30m
BIBLIOGRAPHY_TASK_CONCURRENCY=2
BIBLIOGRAPHY_TASK_TIMEOUT=45s
BIBLIOGRAPHY_TASK_MAX_RETRY=2
BIBLIOGRAPHY_RESULT_RETENTION=30m

# Host-side `make dev` frontend settings.
# Use 0.0.0.0 to let other devices on the LAN open the dev UI. The dev stack has
# no authentication, so keep 127.0.0.1 unless you intentionally want that exposure.
VITE_HOST=127.0.0.1
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# File storage and parser connection
FILE_STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
# Optional shared trusted root for recognizers that return OutputMode=directory.
# The API copies the named Markdown file into FileStorage after validating it.
RECOGNITION_OUTPUT_DIR=./data/recognition-output
FILE_MAX_UPLOAD_SIZE=104857600
PARSER_GRPC_ADDR=localhost:50051
# The local Python gRPC parser is the normal PDF recognition path. Set this
# to default only when intentionally running without that process.
DOCUMENT_RECOGNITION_DRIVER=builtin
PARSER_GRPC_MAX_MESSAGE_SIZE=105906176
# PDF image/table block previews use 144 DPI by default. PARSER_MAX_IMAGE_DPI is
# a hard ceiling; PARSER_MAX_CROP_PIXELS downsamples a single crop that would
# otherwise allocate too much memory. Page edge is in PDF points (72/inch).
PARSER_IMAGE_DPI=144
PARSER_MAX_IMAGE_DPI=300
PARSER_MAX_PAGES=2000
PARSER_MAX_PAGE_EDGE_POINTS=5000
PARSER_MAX_CROP_PIXELS=20000000
PARSER_MAX_CROPS_PER_DOCUMENT=500
PARSER_MAX_CROP_BYTES=50331648
PARSER_MAX_RECOGNITION_MARKDOWN_BYTES=33554432
# Shared gRPC worker pool and admission control. Keep these aligned with the
# Go-side DOCUMENT_*_CONCURRENCY values below.
# shared: lightweight server + one on-demand worker per kind, each with an
# internal thread pool (shared model, idle exit). worker: per-task subprocess
# pools. inprocess: old single gRPC process.
PARSER_EXECUTION_MODE=shared
PARSER_MAX_WORKERS=8
PARSER_MAX_CONCURRENT_RPCS=8
# The parser server is always lightweight. Heavy recognition/extraction work
# runs in kind-specific workers that are started on demand and exit after this
# idle period (the spawned worker uses 2x PARSER_WORKER_IDLE_SECONDS).
PARSER_RECOGNIZE_WORKER_MAX=1
PARSER_EXTRACT_WORKER_MAX=1
PARSER_RENDER_WORKER_MAX=1
PARSER_RECOGNIZE_CONCURRENCY=4
PARSER_EXTRACT_CONCURRENCY=4
PARSER_RENDER_CONCURRENCY=4
PARSER_WORKER_IDLE_SECONDS=120
PARSER_RENDER_WORKER_IDLE_SECONDS=120
# Large recognition responses fragment glibc per-thread allocator arenas; the
# lightweight gRPC server keeps that freed memory resident after workers exit.
# Every N seconds it runs gc + malloc_trim(0) (0 disables). MALLOC_ARENA_MAX
# caps how many per-thread arenas glibc may create.
PARSER_MEMORY_TRIM_SECONDS=60
PARSER_MALLOC_ARENA_MAX=2
# Fixed mmap/trim thresholds keep large response buffers out of long-lived
# per-thread arenas; 131072 bytes is glibc's default starting threshold.
PARSER_MALLOC_MMAP_THRESHOLD=131072
PARSER_MALLOC_TRIM_THRESHOLD=131072
# Keep the ONNX layout engine for per-page blocks/boxes/crops. The thread cap
# is the important guard: without it each worker starts a full-core ONNX pool.
# false is a legacy fallback, but returns blocks=0 (no Block selection/evidence).
PARSER_PYMUPDF_LAYOUT=true
# ONNX intra-op threads. shared/inprocess: one shared pool (core count).
# worker: per process; use cores / PARSER_RECOGNIZE_WORKER_MAX (e.g. 4).
PARSER_LAYOUT_THREADS=16
PARSER_WORKER_MAX_JOBS=50
PARSER_WORKER_QUEUE_TIMEOUT=30
PARSER_WORKER_START_TIMEOUT=90
# Synchronous page/region rendering; no Asynq queue is involved.
PARSER_RENDER_TIMEOUT=15
PARSER_RENDER_MAX_DPI=300
PARSER_RENDER_MAX_PIXELS=20000000
PARSER_RENDER_MAX_OUTPUT_BYTES=12582912
# Per-RPC backstop when the client omits a deadline, and graceful SIGTERM drain.
PARSER_RPC_MAX_SECONDS=900
PARSER_SHUTDOWN_GRACE_SECONDS=30
# Bounds for the independent paper metadata extraction RPC.
PARSER_MAX_EXTRACTION_MARKDOWN_BYTES=33554432
PARSER_MAX_EXTRACTION_BLOCKS=50000
PARSER_MAX_EXTRACTION_LAYOUT_LINES=100000
# `hybrid` lazily rebuilds bounded PDF layout facts inside the Python parser
# when compatible artifacts are available; otherwise it preserves
# deterministic Markdown rules. `shadow` returns/persists rules while logging
# aggregate, content-free CRF disagreement counters. `crf` uses the header and
# citation CRFs and fails parser startup if a required artifact is
# incompatible; reference entries stay rule-owned by default. With
# PAPER_REFERENCE_CRF_ENABLED=true it restores the full three-model cascade.
PAPER_EXTRACTION_ENGINE=hybrid
# Runtime CRF bundle root: models/ + weights/ + specs/. The parser defaults to
# pdf_parser/paper_crf; override only to evaluate another promoted bundle.
PAPER_CRF_MODEL_DIR=./pdf_parser/paper_crf
# Reference-region CRF is disabled by default: references stay rule-owned.
# Set true only to evaluate the learned reference region (header and citation
# CRFs remain active either way in non-rules modes).
PAPER_REFERENCE_CRF_ENABLED=false

# Scholarly catalog adapters. The dispatcher runs one worker per provider;
# source jobs are taken before reference jobs. See OPERATIONS.md.
# API keys are optional for low-volume local development; do not commit values.
PAPER_CATALOG_PROVIDERS=arxiv,semantic_scholar,openalex,crossref
PAPER_CATALOG_TIMEOUT=10s
# Deprecated: source fan-out moved to the in-process dispatcher (one worker per
# provider). The value is retained for configuration compatibility.
PAPER_CATALOG_CONCURRENCY=4
# Provider-specific timeout and spacing. The in-process dispatcher runs one
# worker per provider, so catalog queries are serialized per provider; the
# concurrency values remain the shared limiter ceiling for any direct caller.
# Global provider leases live in Redis when REDIS_ADDR is configured.
PAPER_CATALOG_ARXIV_TIMEOUT=20s
PAPER_CATALOG_ARXIV_SPACING=3s
PAPER_CATALOG_ARXIV_CONCURRENCY=1
PAPER_CATALOG_SEMANTIC_SCHOLAR_TIMEOUT=10s
PAPER_CATALOG_SEMANTIC_SCHOLAR_SPACING=1s
PAPER_CATALOG_SEMANTIC_SCHOLAR_CONCURRENCY=1
PAPER_CATALOG_OPENALEX_TIMEOUT=10s
PAPER_CATALOG_OPENALEX_SPACING=1s
PAPER_CATALOG_OPENALEX_CONCURRENCY=1
PAPER_CATALOG_CROSSREF_TIMEOUT=10s
PAPER_CATALOG_CROSSREF_SPACING=500ms
PAPER_CATALOG_CROSSREF_CONCURRENCY=1
# Admission budget (not a running-concurrency bound): how many distinct
# unknown references one dispatch submits at once. Set above the largest
# realistic bibliography so one round covers the whole list; parallelism is
# governed by the dispatcher admission caps and provider spacing below.
PAPER_REFERENCE_CATALOG_MAX_PER_DOCUMENT=200
# In-process dispatcher admission caps for reference catalog work: the global
# reference cap and the cap for one citing document. Keeping the global cap
# below the provider count leaves provider slots available for source lookups.
PAPER_REFERENCE_CATALOG_CONCURRENCY=2
PAPER_REFERENCE_CATALOG_PER_DOCUMENT_CONCURRENCY=1
# Source lookup stops after an exact DOI/arXiv match or a candidate score at
# or above this threshold; lower-confidence candidates are applied but the
# dispatcher still tries the next provider.
PAPER_CATALOG_SOURCE_STOP_SCORE=0.9
# External provider resolution is manual by default. Local DOI/title matching
# still runs immediately after extraction.
PAPER_REFERENCE_AUTO_RESOLVE=false
PAPER_CATALOG_USER_AGENT=papersManager/1.0
PAPER_EXTRACTION_TASK_TIMEOUT=2m
PAPER_EXTRACTION_TASK_MAX_RETRY=3
PAPER_CATALOG_TASK_TIMEOUT=10m
PAPER_CATALOG_TASK_MAX_RETRY=5
# Explicit URL imports use the same SSRF-protected PDF downloader and share
# FILE_MAX_UPLOAD_SIZE as their byte limit.
REMOTE_PDF_DOWNLOAD_TIMEOUT=2m
REMOTE_PDF_MAX_REDIRECTS=5
REMOTE_PDF_DOWNLOAD_CONCURRENCY=2
REMOTE_PDF_HOST_CONCURRENCY=1
REMOTE_PDF_HOST_SPACING=1s
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Supplying a contact address opts Crossref requests into its polite pool.
CROSSREF_MAILTO=

# Recognition tasks use Asynq. Docker Compose supplies Redis on this address;
# start a compatible Redis instance before running the API directly.
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
# Worker pool size and how long SIGTERM waits for running tasks. Tasks still
# running after this timeout are interrupted and their stages are failed on
# the next startup (users retry explicitly).
ASYNQ_CONCURRENCY=32
# Independent limits for the two parser-backed task types. Waiting tasks hold
# only an Asynq worker goroutine; source files/content are loaded after entry.
DOCUMENT_RECOGNITION_CONCURRENCY=4
DOCUMENT_EXTRACTION_CONCURRENCY=4
ASYNQ_SHUTDOWN_TIMEOUT=30s

# Docker resource guards. memswap_limit == mem_limit disables container swap,
# so a runaway worker is OOM-killed instead of stalling the whole VM.
PARSER_MEM_LIMIT=4g
PARSER_CPUS=16
API_MEM_LIMIT=1g
API_CPUS=4
POSTGRES_MEM_LIMIT=768m
REDIS_MEM_LIMIT=256m
WEB_MEM_LIMIT=256m

# Background recovery for queued/processing documents
DOCUMENT_HOUSEKEEPING_ENABLED=true
DOCUMENT_HOUSEKEEPING_INTERVAL=5m
DOCUMENT_STALE_THRESHOLD=1h10m
PROCESSING_SPAN_RETENTION_ENABLED=true
PROCESSING_SPAN_SUCCESS_RETENTION=720h
PROCESSING_SPAN_FAILURE_RETENTION=2160h
PROCESSING_SPAN_RETENTION_BATCH=500

# Structured logs. LOG_PATH may be an absolute path in production.
LOG_LEVEL=info
LOG_PATH=Logs/server.log

# Docker builds: use host.docker.internal rather than 127.0.0.1 for a
# proxy running on the host. Uncomment and replace 7890 as appropriate.
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,postgres,redis,parser,api,web
# For a proxy bound only to the Linux/WSL loopback interface:
# BUILD_NETWORK=host
