PAPER_MANAGER_VERSION=1.0.0
# Images are prepared locally first; registry publication is not implemented yet.
PAPER_MANAGER_IMAGE_PREFIX=ghcr.io/aciv/paper-manager
# Relative to this compose file, not the shell's working directory.
PAPER_MANAGER_DATA_DIR=./data
WEB_PORT=5173
MCP_PORT=8090

# Use URL-safe letters, digits, _ or -; it is inserted into the database URL.
POSTGRES_PASSWORD=replace_with_a_local_password
# Optional for local loopback access. Copy this same token into the Agent client.
MCP_TOKEN=

ASYNQ_CONCURRENCY=32
PARSER_RECOGNIZE_CONCURRENCY=4
PARSER_EXTRACT_CONCURRENCY=4
PARSER_RENDER_CONCURRENCY=4
PARSER_MAX_CONCURRENT_RPCS=8
PARSER_LAYOUT_THREADS=2
PARSER_IMAGE_DPI=144
PARSER_CPUS=4
PARSER_MEM_LIMIT=4g

SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=
